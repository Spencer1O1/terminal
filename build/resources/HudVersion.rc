// Version resources for the independently packaged Windows Terminal HUD fork.
// Keep the numeric version in sync with Package-HUD.appxmanifest.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,25,2733,2
 PRODUCTVERSION 1,25,2733,2
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_UNKNOWN
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Spencer1O1\0"
            VALUE "FileDescription", "Windows Terminal HUD\0"
            VALUE "FileVersion", "1.25.2733.2\0"
            VALUE "ProductName", "Windows Terminal HUD\0"
            VALUE "ProductVersion", "1.25.2733.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
